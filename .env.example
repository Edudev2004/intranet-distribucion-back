# Plantilla de Configuración de Base de Datos - Supabase PostgreSQL
DB_HOST=aws-0-us-east-2.pooler.supabase.com
DB_PORT=6543
DB_NAME=postgres
DB_USERNAME=postgres.tu_user
DB_PASSWORD=proyar

# Configuración de Seguridad JWT
JWT_SECRET=coloca_aqui_una_clave_secreta_aleatoria_de_64_caracteres
JWT_EXPIRATION=86400000

# Configuración Supabase Storage (Protocolo S3)
STORAGE_S3_ENDPOINT=https://tu_proyecto.storage.supabase.co/storage/v1/s3
STORAGE_S3_REGION=us-east-2
STORAGE_S3_ACCESS_KEY=tu_access_key_id
STORAGE_S3_SECRET_KEY=tu_secret_access_key
STORAGE_S3_BUCKET=evidencias-entregas
STORAGE_PUBLIC_URL=https://tu_proyecto.supabase.co/storage/v1/object/public/evidencias-entregas
